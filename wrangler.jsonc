{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaohsiung-central-park",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // 自訂 Worker 進入點：先做 www.→apex 與 http→https 的 301 規範化重導向，
  // 再委派給 Astro + @astrojs/cloudflare 的 SSR handler（dist/server/entry.mjs）。
  // 注意：dist/server/entry.mjs 由 `astro build` 產生，必須先建置再 wrangler deploy。
  "main": "./src/worker.ts",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
