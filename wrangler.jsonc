{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kaohsiung-central-park",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // @astrojs/cloudflare 14 會將 SSR worker 輸出到 dist/server/entry.mjs，
  // 靜態資源（sitemap、圖片、PWA 圖示與 SW）則輸出到 dist/client。
  // 設定需與 dist/server/wrangler.json（adapter 建置時自動產生）一致。
  "no_bundle": true,
  "main": "./dist/server/entry.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  }
}
