---
import { attraction } from '../config/site';
import { responsibilityGroups, scienceCards } from '../data/science';
---

<section id="science" class="anchor-offset py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Science & stewardship</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      {attraction.fullName}的都市生態科普與訪客責任（Nature Notes for
      {attraction.shortNameEn}）
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-600">
      在一座百分之百人造的水泥城市裡，{attraction.displayName}是一片難得的連續綠地。理解它怎麼運作，會讓你的散步變成一堂現地的都市生態課。
    </p>

    <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        scienceCards.map(card => (
          <article class="card-surface overflow-hidden">
            {
              card.image ? (
                <img
                  src={card.image}
                  alt={`${attraction.shortName}的${card.title}觀察場景`}
                  width="800"
                  height="600"
                  loading="lazy"
                  decoding="async"
                  class="h-44 w-full object-cover"
                />
              ) : null
            }
            <div class="p-6">
              <span
                class={`inline-flex rounded-2xl px-3 py-1 text-xs font-bold ${card.tone}`}
              >
                <span aria-hidden="true" class="mr-1.5">{card.icon}</span>
                {card.subtitle}
              </span>
              <h3 class="mt-4 text-lg font-bold text-stone-900">{card.title}</h3>
              <ul class="mt-3 space-y-2 text-sm leading-relaxed text-stone-600">
                {card.points.map(point => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class="text-emerald-600">•</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>

    <h3 class="mt-14 text-xl font-bold text-stone-900">訪客責任：把好狀態留給下一個人</h3>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-stone-600">
      以下為{attraction.city}公有公園常見的管理原則與友善行為整理；涉及法規的部分僅做類型化說明，實際條文以高雄市政府公告為準。
    </p>

    <div class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
      {
        responsibilityGroups.map(group => (
          <section class="card-surface p-6">
            <h4 class="flex items-center gap-2 text-base font-bold text-stone-900">
              <span aria-hidden="true">{group.icon}</span>
              {group.title}
            </h4>
            <dl class="mt-4 space-y-4">
              {group.items.map(item => (
                <div>
                  <dt class="text-sm font-bold text-stone-800">{item.label}</dt>
                  <dd class="mt-1 text-xs leading-relaxed text-stone-600">{item.desc}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))
      }
    </div>
  </div>
</section>
