---
import { attraction, nearbyLandmarks } from '../config/site';
---

<section id="nearby" class="anchor-offset py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Around the park</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      {attraction.shortName}周邊地標與景點（Landmarks & Attractions Around {attraction.shortNameEn}）
    </h2>
    {/* 4.3 周邊語義集群 */}
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-600">
      造訪{attraction.fullName}（{attraction.fullNameEn}）時，旅客可以順道探索周邊的歷史地標與熱門景點，包含<b
        class="font-semibold text-stone-800">城市光廊</b
      >與<b class="font-semibold text-stone-800">新堀江商圈</b>，步行距離都在 10 分鐘內，很適合排成半日散步行程。
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        nearbyLandmarks.map(item => (
          <article class="card-surface overflow-hidden">
            <img
              src={item.image}
              alt={item.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="h-44 w-full object-cover"
            />
            <div class="p-5">
              <h3 class="text-base font-bold text-stone-900">
                {item.name}
                <span class="mt-1 block text-xs font-medium tracking-wide text-stone-500">
                  {item.nameEn}
                </span>
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-stone-600">{item.desc}</p>
              <p class="mt-3 inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
                {item.distance}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
