---
import { GROUP_LABELS, GROUP_ORDER, TOPICS, TOPIC_UI, topicPath } from '../data/topics';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = TOPIC_UI[locale];
const en = locale === 'en';
const groups = GROUP_ORDER.map(group => ({
  label: GROUP_LABELS[locale][group],
  items: TOPICS.filter(t => t.group === group),
}));
---

<section id="guides" class="guide-section topic-hub">
  <div class="section-copy">
    <span class="section-index">{en ? 'FURTHER READING' : '延伸閱讀'}</span>
    <h2>{ui.hubTitle}</h2>
    <p>{ui.hubIntro}</p>
  </div>
  <div class="topic-hub-grid">
    {
      groups.map(group => (
        <div class="topic-hub-group">
          <h3>{group.label}</h3>
          <ul>
            {group.items.map(t => (
              <li>
                <a href={topicPath(t.slug, locale)}>{t[locale].h1}</a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <p class="topic-hint">{ui.independentNote}</p>
</section>
