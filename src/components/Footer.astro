---
import { attraction, siteConfig } from '../config/site';
import { t, type Locale } from '../i18n';

interface Props {
  locale?: Locale;
}

const { locale = 'zh' } = Astro.props;

const year = new Date().getFullYear();
const anchors = [
  { href: '#about', key: 'footerIntro' as const },
  { href: '#location', key: 'footerLocation' as const },
  { href: '#nearby', key: 'footerNearby' as const },
  { href: '#history', key: 'footerHistory' as const },
  { href: '#reviews', key: 'footerReviews' as const },
  { href: '#faq', key: 'footerFaq' as const },
  { href: '#sources', key: 'footerSources' as const },
];

const introText =
  locale === 'en'
    ? `${siteConfig.brandDomain} is an independent visitor guide to ${attraction.fullNameEn} (${attraction.cityEn}), gathering location maps, transport routes, park highlights and official tourism links for trip planning.`
    : `${siteConfig.brandDomain} 是${attraction.fullName}（${attraction.fullNameEn}，${attraction.cityEn}）的獨立參觀指南，整理位置地圖、交通路線、園區亮點與官方旅遊資訊連結，供旅客行前參考。`;

const govtTourismLabel = locale === 'en' ? 'Kaohsiung Travel' : attraction.govtTourismLabel;
const govtMainLabel = locale === 'en' ? 'Kaohsiung City Government' : attraction.govtMainLabel;

const disclaimer =
  locale === 'en'
    ? `The Google Maps rating and review count shown on this site are quoted from Google Maps user reviews (synced September 2026); copyright belongs to the original authors and Google Maps. Always refer to the `
    : `本站標示之 Google 地圖評分與評價數引用自 Google 地圖使用者評價（同步時間 2026 年 9 月），版權歸原作者與 Google 地圖所有；請以 `;

const copyright =
  locale === 'en'
    ? `© ${year} ${siteConfig.name} · ${siteConfig.brandDomain} · Unofficial visitor guide, not affiliated with Google LLC.`
    : `© ${year} ${siteConfig.name} · ${siteConfig.brandDomain} · 非官方旅遊指南，與 Google LLC 無隸屬關係。`;
---

<footer class="mt-20 border-t border-stone-200 bg-stone-900 text-stone-300">
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="flex items-center gap-2">
          <span
            aria-hidden="true"
            class="grid h-9 w-9 place-items-center rounded-xl bg-emerald-600 text-sm font-bold text-white"
            >央</span
          >
          <span class="text-base font-bold text-white">{attraction.displayName}</span>
        </p>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-stone-400">{introText}</p>
        <p class="mt-4 text-xs leading-relaxed text-stone-500">
          {attraction.fullName} → {attraction.city}{attraction.locality} → {attraction.state} →
          {attraction.country} → {attraction.countryEn}
        </p>
      </div>

      <nav aria-label={t(locale, 'onThisPage')}>
        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">
          {t(locale, 'onThisPage')}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          {
            anchors.map(item => (
              <li>
                <a href={item.href} class="transition hover:text-emerald-300">
                  {t(locale, item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">
          {t(locale, 'externalLinks')}
        </p>
        <ul class="mt-4 space-y-2 text-sm">
          <li>
            <a
              href={attraction.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-300">{t(locale, 'googleReviews')}</a
            >
          </li>
          <li>
            <a
              href={attraction.govtTourismUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-300">{govtTourismLabel} ↗</a
            >
          </li>
          <li>
            <a
              href={attraction.govtMainUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="transition hover:text-emerald-300">{govtMainLabel} ↗</a
            >
          </li>
        </ul>
      </div>
    </div>

    <p class="mt-10 border-t border-stone-800 pt-6 text-xs leading-relaxed text-stone-500">
      {disclaimer}<a
        href={attraction.mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-stone-600 underline-offset-2">Google Maps</a
      >{locale === 'en' ? ' original page for the latest data.' : ' 的最新資料為準。'}
    </p>
    <p class="mt-3 text-xs text-stone-600">{copyright}</p>
  </div>
</footer>
