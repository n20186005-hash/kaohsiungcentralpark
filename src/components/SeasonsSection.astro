---
import { attraction } from '../config/site';
import {
  climateNormals,
  normalsLabel,
  quickMonthAdvice,
  seasonRows,
} from '../data/seasons';

const monthLabels = ['1 月', '2 月', '3 月', '4 月', '5 月', '6 月', '7 月', '8 月', '9 月', '10 月', '11 月', '12 月'];
const maxPrecip = Math.max(...climateNormals.map(row => row.precip));
---

<section id="seasons" class="anchor-offset py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Seasonal guide</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      {attraction.fullName}的季節天氣與季度遊覽策略（Best Time to Visit {attraction.shortNameEn}）
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-600">
      {attraction.displayName}屬熱帶季風氣候，全年高溫、降雨集中在夏季。下表為{normalsLabel}，可用來判斷什麼季節來最舒服，以及需要攜帶哪些裝備。
    </p>

    <!-- 季度策略表 -->
    <div class="mt-10">
      <div class="grid gap-6 lg:grid-cols-2">
        {
          seasonRows.map(season => (
            <article class="card-surface overflow-hidden">
              <header class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200 px-6 py-4">
                <div>
                  <h3 class="text-lg font-bold text-stone-900">{season.season}</h3>
                  <p class="text-xs tracking-wide text-stone-500">{season.months}</p>
                </div>
                <p class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-bold text-emerald-800">
                  {season.temp}
                </p>
              </header>

              <dl class="grid grid-cols-2 gap-x-6 gap-y-3 px-6 py-5 text-sm sm:grid-cols-3">
                <div>
                  <dt class="text-xs text-stone-500">季雨量</dt>
                  <dd class="font-semibold text-stone-900">{season.precip}</dd>
                </div>
                <div>
                  <dt class="text-xs text-stone-500">降雨日數</dt>
                  <dd class="font-semibold text-stone-900">{season.rainDays}</dd>
                </div>
                <div>
                  <dt class="text-xs text-stone-500">相對濕度</dt>
                  <dd class="font-semibold text-stone-900">{season.humidity}</dd>
                </div>
                <div>
                  <dt class="text-xs text-stone-500">日照時數</dt>
                  <dd class="font-semibold text-stone-900">{season.sunshine}</dd>
                </div>
                <div class="col-span-2">
                  <dt class="text-xs text-stone-500">人潮狀況</dt>
                  <dd class="font-semibold text-stone-900">{season.crowd}</dd>
                </div>
              </dl>

              <div class="space-y-4 border-t border-stone-200 px-6 py-5 text-sm leading-relaxed">
                <div>
                  <p class="font-bold text-stone-900">自然觀察重點</p>
                  <p class="mt-1 text-stone-600">{season.phenology}</p>
                </div>
                <div>
                  <p class="font-bold text-stone-900">遊覽策略</p>
                  <p class="mt-1 text-stone-600">{season.strategy}</p>
                </div>
                <div>
                  <p class="font-bold text-stone-900">建議裝備</p>
                  <p class="mt-1 text-stone-600">{season.gear.join(' · ')}</p>
                </div>
                <div>
                  <p class="font-bold text-stone-900">風險提醒</p>
                  <ul class="mt-1 space-y-1 text-stone-600">
                    {season.risks.map(risk => (
                      <li class="flex gap-2">
                        <span aria-hidden="true" class="text-amber-600">▲</span>
                        <span>{risk}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <!-- 逐月氣候常年統計 -->
    <div class="mt-12">
      <h3 class="text-xl font-bold text-stone-900">逐月氣候常年統計（{normalsLabel}）</h3>
      <p class="mt-2 text-sm leading-relaxed text-stone-600">
        降水量以長條比例呈現，可清楚看出高雄降雨高度集中在 6–8 月，冬季則明顯乾燥。
      </p>

      <div class="card-surface mt-6 overflow-x-auto p-6">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead>
            <tr class="border-b border-stone-200 text-xs uppercase tracking-wide text-stone-500">
              <th scope="col" class="py-2 pr-3">月份</th>
              <th scope="col" class="py-2 pr-3">均高溫 °C</th>
              <th scope="col" class="py-2 pr-3">均溫 °C</th>
              <th scope="col" class="py-2 pr-3">均低溫 °C</th>
              <th scope="col" class="py-2 pr-3">降水量</th>
              <th scope="col" class="py-2 pr-3">雨日</th>
              <th scope="col" class="py-2 pr-3">濕度</th>
              <th scope="col" class="py-2">日照 h</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-stone-100">
            {
              climateNormals.map(row => (
                <tr>
                  <th scope="row" class="py-2 pr-3 font-medium text-stone-900">
                    {monthLabels[row.month - 1]}
                  </th>
                  <td class="py-2 pr-3 text-stone-700">{row.max}</td>
                  <td class="py-2 pr-3 text-stone-700">{row.mean}</td>
                  <td class="py-2 pr-3 text-stone-700">{row.min}</td>
                  <td class="py-2 pr-3">
                    <span class="flex items-center gap-2">
                      <span
                        class="h-2 rounded-full bg-sky-500"
                        style={`width:${Math.max(4, Math.round((row.precip / maxPrecip) * 90))}px`}
                        aria-hidden="true"
                      />
                      <span class="text-stone-700">{row.precip} mm</span>
                    </span>
                  </td>
                  <td class="py-2 pr-3 text-stone-700">{row.rainDays}</td>
                  <td class="py-2 pr-3 text-stone-700">{row.humidity}%</td>
                  <td class="py-2 text-stone-700">{row.sunshine}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>

    <!-- 月份速查 -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        quickMonthAdvice.map(item => (
          <div class="card-surface p-5">
            <p class="text-sm font-bold text-emerald-800">{item.months}</p>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.advice}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-8 text-xs leading-relaxed text-stone-500">
      常年統計反映的是長期平均狀態，不代表單一天氣；實際行程請搭配上方即時預報，並留意颱風警報與豪雨特報。
    </p>
  </div>
</section>
