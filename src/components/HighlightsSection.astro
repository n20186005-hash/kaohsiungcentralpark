---
import { attraction, highlights } from '../config/site';
---

<section id="highlights" class="anchor-offset bg-white py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Highlights</p>
    <h2 class="mt-3 max-w-3xl text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      園區亮點與設施：造訪{attraction.shortName}必看的六個角落
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-600">
      以下是{attraction.displayName}最常被旅客與市民使用的空間，皆位於平坦步道沿線，散步一圈即可串起。
    </p>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        highlights.map(item => (
          <article class="card-surface overflow-hidden transition hover:-translate-y-0.5 hover:shadow-md">
            <img
              src={item.image}
              alt={item.alt}
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
              class="h-48 w-full object-cover"
            />
            <div class="p-5">
              <h3 class="text-lg font-bold text-stone-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-stone-600">{item.desc}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
