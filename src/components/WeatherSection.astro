---
import { attraction } from '../config/site';
import { getWeatherSnapshot } from '../data/weather';
import {
  buildDayTip,
  buildWeatherAdvice,
  describeHumidity,
  describeRainChance,
  describeUv,
  describeWind,
} from '../data/weather-advice';
import { normalsLabel } from '../data/seasons';

// 於伺服器端（或建置時）取得即時天氣，結果會在伺服器暫存 15 分鐘。
const weather = await getWeatherSnapshot(attraction.lat, attraction.lng);
const today = weather?.days[0];
const upcoming = weather?.days.slice(1) ?? [];
const advice = weather && today ? buildWeatherAdvice(weather.now, today) : null;

const summaryTone: Record<string, string> = {
  good: 'bg-emerald-50 text-emerald-900 border-emerald-200',
  notice: 'bg-amber-50 text-amber-900 border-amber-200',
  alert: 'bg-rose-50 text-rose-900 border-rose-200',
};
---

<section id="weather" class="anchor-offset border-t border-stone-200 bg-stone-100 py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Weather & advice</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      {attraction.fullName}即時天氣與未來 7 日預報（{attraction.fullNameEn} Weather）
    </h2>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-stone-600">
      出發前先看這一眼：{attraction.displayName}位於{attraction.country}{attraction.city}
      {attraction.locality}，屬熱帶季風氣候，午後陣雨與夏日高溫都來得快。以下為園區座標（{attraction.lat},
      {attraction.lng}）的即時觀測與未來一週預報，並把數字直接翻成「今天該怎麼穿、適不適合出門、背包要帶什麼」。
      本園屬都市公園環境：有成片樹蔭、開闊草地與生態池水域，建議邏輯因此著重在體感悶熱、午後陣雨、雷雨時的開闊地安全與紫外線防護。
    </p>

    {
      weather && today && advice ? (
        <>
          {advice.alerts.length > 0 ? (
            <div class="mt-8 rounded-3xl border-2 border-rose-300 bg-rose-50 p-6">
              <p class="flex items-center gap-2 text-base font-extrabold text-rose-900">
                <span aria-hidden="true" class="text-xl leading-none">⚠️</span>
                風險提醒（請優先考量安全）
              </p>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {advice.alerts.map(alert => (
                  <li class="rounded-2xl bg-white/80 p-4">
                    <p class="flex items-center gap-2 text-sm font-bold text-rose-800">
                      <span aria-hidden="true">{alert.icon}</span>
                      {alert.title}
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-stone-700">{alert.text}</p>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-xs leading-relaxed text-rose-800">
                以上為本站依預報數值自動判斷的提醒；颱風、豪雨等正式警報請以交通部中央氣象署與高雄市政府公告為準。
              </p>
            </div>
          ) : null}

          {advice.notices.length > 0 ? (
            <div class="mt-4 rounded-3xl border border-amber-300 bg-amber-50 p-6">
              <p class="flex items-center gap-2 text-base font-extrabold text-amber-900">
                <span aria-hidden="true" class="text-xl leading-none">🔎</span>
                天氣注意事項
              </p>
              <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                {advice.notices.map(notice => (
                  <li class="rounded-2xl bg-white/80 p-4">
                    <p class="flex items-center gap-2 text-sm font-bold text-amber-800">
                      <span aria-hidden="true">{notice.icon}</span>
                      {notice.title}
                    </p>
                    <p class="mt-2 text-sm leading-relaxed text-stone-700">{notice.text}</p>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}

          <div class="mt-8 grid gap-6 lg:grid-cols-[0.85fr_1.15fr]">
            <div class="card-surface overflow-hidden">
              <div class="flex items-start justify-between gap-4 bg-emerald-700 px-6 py-5 text-white">
                <div>
                  <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-200">
                    Now · 即時天氣
                  </p>
                  <p class="mt-3 flex items-baseline gap-2">
                    <span class="text-6xl font-extrabold leading-none">{weather.now.temp}°</span>
                    <span class="text-sm text-emerald-100">體感 {weather.now.feelsLike}°C</span>
                  </p>
                  <p class="mt-3 flex items-center gap-2 text-base font-bold">
                    <span aria-hidden="true" class="text-2xl leading-none">{weather.now.icon}</span>
                    <span>{weather.now.label}</span>
                  </p>
                </div>
                <p class="text-right text-xs text-emerald-200">
                  {weather.now.isDay ? '白天' : '夜間'}<br />更新 {weather.updatedAt}
                </p>
              </div>

              <dl class="grid grid-cols-2 gap-x-6 gap-y-4 px-6 py-5 text-sm">
                <div>
                  <dt class="text-stone-500">降雨機率</dt>
                  <dd class="text-lg font-bold text-stone-900">{today.precipProb}%</dd>
                  <dd class="text-xs text-stone-500">{describeRainChance(today.precipProb)}</dd>
                </div>
                <div>
                  <dt class="text-stone-500">今日氣溫</dt>
                  <dd class="text-lg font-bold text-stone-900">
                    {today.max}° <span class="text-stone-500">/ {today.min}°</span>
                  </dd>
                  <dd class="text-xs text-stone-500">早晚溫差 {today.max - today.min}°C</dd>
                </div>
                <div>
                  <dt class="text-stone-500">風勢</dt>
                  <dd class="text-lg font-bold text-stone-900">{weather.now.wind} km/h</dd>
                  <dd class="text-xs text-stone-500">{describeWind(weather.now.wind)}</dd>
                </div>
                <div>
                  <dt class="text-stone-500">紫外線</dt>
                  <dd class="text-lg font-bold text-stone-900">{weather.now.uv}</dd>
                  <dd class="text-xs text-stone-500">{describeUv(weather.now.uv)}</dd>
                </div>
                <div>
                  <dt class="text-stone-500">空氣濕度</dt>
                  <dd class="text-lg font-bold text-stone-900">{weather.now.humidity}%</dd>
                  <dd class="text-xs text-stone-500">{describeHumidity(weather.now.humidity)}</dd>
                </div>
                <div>
                  <dt class="text-stone-500">目前降雨</dt>
                  <dd class="text-lg font-bold text-stone-900">{weather.now.precip} mm</dd>
                  <dd class="text-xs text-stone-500">
                    {weather.now.precip > 0 ? '地面濕滑請放慢腳步' : '目前未測得降雨'}
                  </dd>
                </div>
                <div>
                  <dt class="text-stone-500">日出</dt>
                  <dd class="text-lg font-bold text-stone-900">{today.sunrise}</dd>
                </div>
                <div>
                  <dt class="text-stone-500">日落</dt>
                  <dd class="text-lg font-bold text-stone-900">{today.sunset}</dd>
                </div>
              </dl>
            </div>

            <div class="card-surface p-6">
              <div class={`rounded-2xl border px-4 py-3.5 ${summaryTone[advice.summary.tone]}`}>
                <p class="flex flex-wrap items-center gap-2 text-base font-extrabold">
                  <span aria-hidden="true">{advice.summary.icon}</span>
                  {advice.summary.label}
                </p>
                <p class="mt-1.5 text-sm leading-relaxed opacity-90">{advice.summary.text}</p>
              </div>

              <div class="mt-5 grid gap-4 sm:grid-cols-2">
                <div class="rounded-2xl border border-amber-100 bg-amber-50/70 p-4">
                  <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-amber-800">
                    <span aria-hidden="true">✅</span>出行穿搭
                  </p>
                  <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-stone-700">
                    {advice.outfit.map(item => (
                      <li class="flex gap-2">
                        <span aria-hidden="true">{item.icon}</span>
                        <span>{item.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <div class="rounded-2xl border border-emerald-100 bg-emerald-50 p-4">
                  <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-emerald-800">
                    <span aria-hidden="true">🗺️</span>遊玩安排
                  </p>
                  <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-stone-700">
                    {advice.plan.map(item => (
                      <li class="flex gap-2">
                        <span aria-hidden="true">{item.icon}</span>
                        <span>{item.text}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-4 rounded-2xl border border-sky-100 bg-sky-50 p-4">
                <p class="flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-sky-800">
                  <span aria-hidden="true">🎒</span>隨身物品
                </p>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {advice.items.map(item => (
                    <li class="inline-flex items-center gap-1.5 rounded-full bg-white px-3 py-1.5 text-sm font-medium text-stone-800 shadow-sm">
                      <span aria-hidden="true">{item.icon}</span>
                      {item.text}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>

          <div class="mt-6 card-surface p-6">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">
              7-day forecast · 未來 7 日
            </p>

            <div class="mt-4 overflow-x-auto">
              <table class="w-full min-w-[36rem] text-left text-sm">
                <thead>
                  <tr class="border-b border-stone-200 text-xs uppercase tracking-wide text-stone-500">
                    <th scope="col" class="py-2 pr-3">日期</th>
                    <th scope="col" class="py-2 pr-3">天氣</th>
                    <th scope="col" class="py-2 pr-3">氣溫</th>
                    <th scope="col" class="py-2 pr-3">體感高溫</th>
                    <th scope="col" class="py-2 pr-3">降雨機率</th>
                    <th scope="col" class="py-2 pr-3">紫外線</th>
                    <th scope="col" class="py-2">一句話提醒</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-stone-100">
                  {weather.days.map((day, index) => {
                    const tip = buildDayTip(day);
                    return (
                      <tr class={index === 0 ? 'bg-emerald-50/60' : undefined}>
                        <th scope="row" class="py-3 pr-3 font-medium text-stone-900">
                          {index === 0 ? '今天' : day.weekday}{' '}
                          <span class="text-stone-500">{day.label}</span>
                        </th>
                        <td class="py-3 pr-3">
                          <span aria-hidden="true">{day.icon}</span>{' '}
                          <span class="text-stone-700">{day.condition}</span>
                        </td>
                        <td class="py-3 pr-3 font-medium text-stone-900">
                          {day.max}° <span class="text-stone-500">/ {day.min}°</span>
                        </td>
                        <td class="py-3 pr-3 text-stone-700">{day.feelsMax}°</td>
                        <td class="py-3 pr-3">
                          <span class={day.precipProb >= 50 ? 'font-bold text-sky-700' : 'text-stone-700'}>
                            {day.precipProb}%
                          </span>
                          {day.precipSum > 0 ? (
                            <span class="text-stone-500"> · {day.precipSum} mm</span>
                          ) : null}
                        </td>
                        <td class="py-3 pr-3 text-stone-700">{day.uvMax}</td>
                        <td class="py-3">
                          <span class="inline-flex items-center gap-1 whitespace-nowrap rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-stone-700 ring-1 ring-stone-200">
                            <span aria-hidden="true">{tip.icon}</span>
                            {tip.label}
                          </span>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>

            {
              upcoming.filter(day => day.precipProb >= 60).length > 0 ? (
                <p class="mt-4 rounded-2xl bg-sky-50 px-4 py-3 text-sm leading-relaxed text-sky-900">
                  未來幾天
                  {upcoming
                    .filter(day => day.precipProb >= 60)
                    .map(day => `${day.label}（${day.precipProb}%）`)
                    .join('、')}
                  降雨機率偏高，建議把室內備案（車站商圈、地下街、圖書館與文學館）排進行程。
                </p>
              ) : null
            }
          </div>
        </>
      ) : (
        <div class="mt-10 card-surface p-6">
          <h3 class="text-base font-bold text-stone-900">目前取得的即時觀測資料暫不可用</h3>
          <p class="mt-2 text-sm leading-relaxed text-stone-600">
            即時天氣暫時無法取得，規劃行程時可先參考下方的「季節天氣與季度遊覽策略」（{normalsLabel}），或查閱交通部中央氣象署的最新預報。
          </p>
        </div>
      )
    }

    <p class="mt-6 text-xs leading-relaxed text-stone-500">
      氣象資料來源：Open-Meteo 開放氣象資料，於伺服器端取得並暫存；降雨機率為預報值，不代表當天一定降雨。本站另提供
      {normalsLabel}作為長期規劃參考。如遇颱風或豪雨警報，請以交通部中央氣象署與高雄市政府公告為準。
    </p>
  </div>
</section>
