---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getTopic, GROUP_LABELS, TOPIC_UI, relatedFor, topicPath, type Topic } from '../data/topics';
import type { Locale } from '../i18n';

interface Props {
  slug: string;
  locale: Locale;
}

const { slug, locale } = Astro.props;
const topic: Topic | undefined = getTopic(slug);
if (!topic) throw new Error(`Unknown topic: ${slug}`);

const en = locale === 'en';
const c = topic[locale];
const ui = TOPIC_UI[locale];
const groupLabel = GROUP_LABELS[locale][topic.group];
const path = topicPath(slug, locale);
const base = en ? '/en/' : '/';
const origin = 'https://kaohsiungcentralpark.com';
const canonical = `${origin}${path}`;
const homeUrl = `${origin}${base}`;
const related = relatedFor(topic);

// JSON-LD: BreadcrumbList + Article. No Event schema (no confirmed events),
// no aggregateRating (Google ratings are not collected by this site).
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${canonical}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: ui.homeCrumb, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: groupLabel, item: `${homeUrl}#guides` },
    { '@type': 'ListItem', position: 3, name: c.h1, item: canonical },
  ],
};

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: c.h1,
  description: c.description,
  url: canonical,
  inLanguage: en ? 'en' : 'zh-Hant-TW',
  dateModified: '2026-11-06',
  author: { '@type': 'Organization', name: 'Kaohsiung Central Park independent guide', url: homeUrl },
  publisher: { '@type': 'Organization', name: 'Kaohsiung Central Park independent guide', url: homeUrl },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${canonical}#webpage` },
  about: {
    '@type': 'Place',
    name: en ? 'Kaohsiung Central Park' : '高雄中央公園',
    url: homeUrl,
  },
  isPartOf: { '@id': `${origin}/#website` },
} as const;

const itemListLd = c.itemList
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': `${canonical}#itinerary`,
      name: `${c.h1} — ${ui.routeLabel}`,
      itemListElement: c.itemList.map((item, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: item,
      })),
    }
  : null;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${canonical}#faq`,
  mainEntity: c.faq.map(f => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout
  locale={locale}
  title={c.metaTitle}
  description={c.description}
  canonicalPath={path}
>
  <link slot="head" rel="alternate" hreflang="zh-Hant" href={`${origin}/${slug}/`} />
  <link slot="head" rel="alternate" hreflang="en" href={`${origin}/en/${slug}/`} />
  <link slot="head" rel="alternate" hreflang="x-default" href={`${origin}/en/${slug}/`} />
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(breadcrumbLd)}
  ></script>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(articleLd)}
  ></script>
  {itemListLd && (
    <script
      slot="head"
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(itemListLd)}
    ></script>
  )}
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>

  <article class="guide-wrap guide-body topic-page" aria-labelledby="topic-title">
    <nav class="topic-breadcrumb" aria-label={en ? 'Breadcrumb' : '麵包屑'}>
      <a href={base}>{ui.homeCrumb}</a><span aria-hidden="true"> / </span><span>{groupLabel}</span
      ><span aria-hidden="true"> / </span><span aria-current="page">{c.h1}</span>
    </nav>

    <p class="topic-eyebrow">{groupLabel}</p>
    <h1 id="topic-title">{c.h1}</h1>
    <p class="topic-lead">{c.lead}</p>
    <p class="topic-updated">
      {ui.checkedLabel}：{c.updated}
    </p>

    <div class="topic-quick">
      <a class="button" href={base}>← {ui.homeLink}</a>
      {c.mapCta && (
        <a
          class="button secondary"
          href="https://maps.app.goo.gl/eC8hTJNhAbFwetQUA"
          target="_blank"
          rel="noopener noreferrer"
        >
          {c.mapCta}
        </a>
      )}
    </div>

    {c.itemList && (
      <section class="topic-section" aria-label={ui.routeLabel}>
        <h2>{ui.routeLabel}</h2>
        <ol class="topic-steps">
          {c.itemList.map(item => <li>{item}</li>)}
        </ol>
        <p class="topic-hint">{ui.verifyNote}</p>
      </section>
    )}

    {c.sections.map(section => (
      <section class="topic-section">
        <h2>{section.heading}</h2>
        {section.paragraphs?.map(p => <p>{p}</p>)}
        {section.bullets && (
          <ul class="topic-bullets">
            {section.bullets.map(b => <li>{b}</li>)}
          </ul>
        )}
      </section>
    ))}

    {c.images && c.images.length > 0 && (
      <section class="topic-section" aria-label={en ? 'Park photographs' : '園區照片'}>
        <div class="photo-grid">
          {c.images.map((image, index) => (
            <figure class:list={['photo-card', { 'photo-featured': index === 0 }]}>
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                width="1280"
                height="960"
              />
              <figcaption>{image.caption}</figcaption>
            </figure>
          ))}
        </div>
        <p class="topic-hint">{ui.imageNote}</p>
      </section>
    )}

    <section class="topic-section" id="faq">
      <h2>{ui.faqTitle}</h2>
      {c.faq.map(f => (
        <details class="faq">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <section class="topic-section">
      <h2>{ui.sourcesTitle}</h2>
      <ul class="topic-sources">
        {c.sources.map(source => (
          <li>
            <a href={source.url} target="_blank" rel="noopener noreferrer">{source.label} ↗</a>
          </li>
        ))}
      </ul>
      <p class="topic-hint">{ui.verifyNote}</p>
    </section>

    <section class="topic-section">
      <h2>{ui.relatedTitle}</h2>
      <ul class="topic-related">
        {related.map(r => (
          <li>
            <a href={topicPath(r.slug, locale)}>{r[locale].h1}</a>
            <span class="topic-related-group">{GROUP_LABELS[locale][r.group]}</span>
          </li>
        ))}
      </ul>
    </section>

    <p class="topic-independent">{ui.independentNote}</p>
  </article>
</BaseLayout>
