---
import { visitTips } from '../config/site';
---

<section id="tips" class="anchor-offset py-16">
  <div class="mx-auto max-w-6xl px-4">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Visitor tips</p>
    <h2 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      造訪建議：什麼時候來最好玩
    </h2>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        visitTips.map((tip, index) => (
          <div class="card-surface p-6">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-700">
              Tip {String(index + 1).padStart(2, '0')}
            </p>
            <h3 class="mt-3 text-base font-bold text-stone-900">{tip.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-stone-600">{tip.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
