---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {reviewed} from '../data/reviewed-guide';
import type {Locale} from '../i18n';
interface Props{locale?:Locale;title?:string;description?:string;includeFaq?:boolean;canonicalPath?:string;noindex?:boolean;}
const {locale='zh',title,description,includeFaq=false,noindex=false}=Astro.props;
const c=reviewed[locale],origin='https://kaohsiungcentralpark.com';
const path=Astro.props.canonicalPath??Astro.url.pathname;const canonical=new URL(path,origin).href;const home=path==='/'||path==='/en/';
const lang=locale==='en'?'en':'zh-Hant-TW';const pageTitle=title??c.title,pageDescription=description??c.description;
const picture=origin+'/images/og-cover.jpg';const entity=origin+'/#attraction';
const schema=[{'@context':'https://schema.org','@type':'WebSite','@id':origin+'/#website',name:'Kaohsiung Central Park independent guide',url:origin+'/'},{'@context':'https://schema.org','@type':'WebPage','@id':canonical+'#webpage',url:canonical,name:pageTitle,description:pageDescription,inLanguage:lang,isPartOf:{'@id':origin+'/#website'},about:{'@id':entity}},...(home?[{'@context':'https://schema.org','@type':'TouristAttraction','@id':entity,name:'高雄中央公園 / Kaohsiung Central Park',url:origin+'/',sameAs:['https://khh.travel/zh-tw/attractions/detail/336/']}]:[]),...(includeFaq?[{'@context':'https://schema.org','@type':'FAQPage','@id':canonical+'#faq',mainEntity:c.faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}]:[])];
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{pageTitle}</title><meta name="description" content={pageDescription}/><meta name="robots" content={noindex?'noindex,follow':'index,follow,max-image-preview:large'}/><link rel="canonical" href={canonical}/>{home&&<><link rel="alternate" hreflang="zh-Hant" href={origin+'/'}/><link rel="alternate" hreflang="en" href={origin+'/en/'}/><link rel="alternate" hreflang="x-default" href={origin+'/en/'}/></>}<meta property="og:type" content="website"/><meta property="og:title" content={pageTitle}/><meta property="og:description" content={pageDescription}/><meta property="og:url" content={canonical}/><meta property="og:locale" content={locale==='en'?'en_US':'zh_TW'}/><meta property="og:image" content={picture}/><meta property="og:image:alt" content={c.photo}/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={pageTitle}/><meta name="twitter:description" content={pageDescription}/><meta name="twitter:image" content={picture}/><meta name="twitter:image:alt" content={c.photo}/><meta name="theme-color" content="#065f46"/><link rel="icon" href="/favicon-32.png"/>{schema.map(x=><script type="application/ld+json" is:inline set:html={JSON.stringify(x)}/>)}<slot name="head"/></head><body><a href="#main" class="skip-link">{locale==='en'?'Skip to main content':'跳至主要內容'}</a><Header locale={locale}/><main id="main"><slot/></main><Footer locale={locale}/><script is:inline>if('serviceWorker'in navigator){navigator.serviceWorker.getRegistrations().then(rs=>{for(const r of rs){if(new URL(r.active?.scriptURL||r.installing?.scriptURL||location.origin).pathname==='/sw.js')r.update();}}).catch(()=>{});}</script></body></html>
