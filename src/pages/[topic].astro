---
import TopicPage from '../components/TopicPage.astro';
import { TOPIC_SLUGS, getTopic } from '../data/topics';

// Keep topic pages static in both build modes (static preview + Cloudflare SSR build).
export const prerender = true;

export function getStaticPaths() {
  return TOPIC_SLUGS.map(slug => ({ params: { topic: slug }, props: { slug } }));
}

// On-demand rendering ignores getStaticPaths(), so read the slug from the URL.
const slug = Astro.props.slug ?? Astro.params.topic;
if (!getTopic(slug)) return new Response('Not found', { status: 404 });
---
<TopicPage slug={slug} locale="zh" />
