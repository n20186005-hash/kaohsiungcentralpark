import SeasonsSection from '../components/SeasonsSection.astro';
import HighlightsSection from '../components/HighlightsSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import RoutesSection from '../components/RoutesSection.astro';
import LocationSection from '../components/LocationSection.astro';
import TransportGuideSection from '../components/TransportGuideSection.astro';
import NearbySection from '../components/NearbySection.astro';
import HistorySection from '../components/HistorySection.astro';
