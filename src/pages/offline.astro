---
import BaseLayout from '../layouts/BaseLayout.astro';
import { attraction } from '../config/site';

const cached = [
  { href: '/#about', label: '景點介紹' },
  { href: '/#highlights', label: '園區亮點' },
  { href: '/#location', label: '位置與交通' },
  { href: '/#reviews', label: '評分與評價' },
  { href: '/#faq', label: '常見問答' },
];
---

<BaseLayout
  title={`離線瀏覽 · ${attraction.displayName}參觀指南`}
  description={`您目前處於離線狀態，${attraction.displayName}（${attraction.fullNameEn}）的離線快取版本仍可閱讀。`}
  canonicalPath="/offline"
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, follow" />
  </Fragment>

  <section class="mx-auto max-w-3xl px-4 py-24">
    <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-700">Offline</p>
    <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-stone-900 sm:text-4xl">
      目前沒有網路連線
    </h1>
    <p class="mt-4 text-base leading-relaxed text-stone-600">
      您正在閱讀{attraction.displayName}（{attraction.fullNameEn}）的離線版本。已快取的內容仍可瀏覽，包含位置地圖說明、交通方式與同步自
      Google 地圖使用者評價的評分資訊。恢復連線後請重新載入以取得最新內容。
    </p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {
        cached.map(item => (
          <li>
            <a
              href={item.href}
              class="card-surface block px-5 py-4 text-sm font-semibold text-stone-800 transition hover:border-emerald-500 hover:text-emerald-800"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <a
      href="/"
      class="mt-10 inline-flex rounded-full bg-emerald-700 px-6 py-3 text-sm font-bold text-white transition hover:bg-emerald-800"
      >回到指南首頁</a
    >
  </section>
</BaseLayout>
